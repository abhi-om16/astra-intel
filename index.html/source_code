<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ASTRA INTEL</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<style>
:root{--bg:#ECEEE7;--panel:#F8F9F4;--ink:#1D261F;--soft:#5B6659;--line:#C9CFC0;--olive:#47603A;--err:#9B2C2C;--mark:#F3D36B}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "IBM Plex Sans",system-ui,sans-serif}
main{max-width:760px;margin:0 auto;padding:28px 18px 60px}
h1{font-size:2rem;margin:0 0 4px;letter-spacing:.02em}
h2{font-size:1.05rem;margin:0 0 8px}
.sub{color:var(--soft);margin:0 0 22px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:16px;margin-bottom:16px}
input[type=file]{width:100%;padding:10px;border:1px dashed var(--olive);border-radius:6px;background:#fff}
input[type=text],input[type=password]{width:100%;padding:10px;border:1px solid var(--line);border-radius:6px;font:inherit;background:#fff}
button{background:var(--olive);color:#fff;border:0;border-radius:6px;padding:10px 18px;font:inherit;font-weight:600;cursor:pointer}
button:hover{background:#36492C}
:focus-visible{outline:3px solid #B08900;outline-offset:2px}
.row{display:flex;gap:10px}
.status{margin:10px 0 0;color:var(--soft)}
.status.err,.msg.err{color:var(--err)}
details summary{cursor:pointer;font-weight:600}
details label{display:block;margin:10px 0 4px;color:var(--soft);font-size:.9rem}
#log{display:flex;flex-direction:column;gap:12px;margin-bottom:14px}
.msg{padding:12px 14px;border-radius:6px;border:1px solid var(--line);background:var(--panel)}
.msg.user{background:#DDE5D3;align-self:flex-end;max-width:85%}
.msg.err{border-color:var(--err);background:#FBEFEF}
.msg p{margin:0 0 8px;white-space:pre-wrap}
.src{border-left:3px solid var(--olive);padding:6px 10px;margin-top:8px;font-size:.92rem;background:#fff}
.src b{color:var(--olive)}
mark{background:var(--mark);padding:0 2px}
.empty{color:var(--soft);font-style:italic}
</style>
</head>
<body>
<main>
  <h1>ASTRA INTEL</h1>
  <p class="sub">Upload a PDF, read a short summary, and ask questions. Answers come only from your document and show the page they came from.</p>

  <section class="card">
    <h2>1. Upload a document</h2>
    <input type="file" id="file" accept="application/pdf,.pdf" aria-label="Choose a PDF">
    <p id="status" class="status" role="status">No document uploaded yet.</p>
  </section>

  <section class="card" id="sumCard" hidden>
    <h2>Summary</h2>
    <p id="summary"></p>
  </section>

  <section class="card">
    <details>
      <summary>Optional: AI-written answers (Gemini)</summary>
      <label><input type="checkbox" id="useAI"> Use Gemini to write answers from the matching passages</label>
      <label for="key">Gemini API key (kept in this page only, never saved)</label>
      <input type="password" id="key" autocomplete="off">
      <label for="model">Model name</label>
      <input type="text" id="model" value="gemini-2.5-flash">
    </details>
  </section>

  <section>
    <h2>2. Ask questions</h2>
    <div id="log" aria-live="polite"><p class="empty">Your conversation will appear here.</p></div>
    <div class="row">
      <input type="text" id="q" placeholder="e.g. What are the major applications discussed?" aria-label="Your question">
      <button id="askBtn">Ask</button>
    </div>
  </section>
</main>

<script>
pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

const STOP = new Set("a an the and or of to in on for with is are was were be been by as at from that this it its into than then which who whom what when where how not no can will would should could may might also such these those their there has have had do does did but if so about over under between".split(" "));
let chunks = [], idf = {};
const $ = id => document.getElementById(id);
const esc = s => s.replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

// Lowercase, keep words, drop stopwords, strip a plural "s"
function tok(s) {
  return (s.toLowerCase().match(/[a-z0-9]+/g) || [])
    .filter(w => w.length > 1 && !STOP.has(w))
    .map(w => (w.length > 3 && w.endsWith("s") && !w.endsWith("ss")) ? w.slice(0, -1) : w);
}

function setStatus(msg, isErr) {
  const el = $("status");
  el.textContent = msg;
  el.className = "status" + (isErr ? " err" : "");
}

// ---- 1. Upload and extract text page by page ----
$("file").addEventListener("change", async e => {
  const f = e.target.files[0];
  if (!f) return;
  if (f.type !== "application/pdf" && !f.name.toLowerCase().endsWith(".pdf"))
    return setStatus("That file is not a PDF. Choose a .pdf file.", true);
  if (f.size === 0) return setStatus("This file is empty. Choose another PDF.", true);
  setStatus("Reading " + f.name + "...");
  try {
    const pdf = await pdfjsLib.getDocument({ data: await f.arrayBuffer() }).promise;
    const pageTexts = [];
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);
      const tc = await page.getTextContent();
      pageTexts.push(tc.items.map(i => i.str).join(" ").replace(/\s+/g, " ").trim());
    }
    if (pageTexts.join(" ").length < 50)
      return setStatus("No readable text found. This may be a scanned PDF (pictures of text), which needs OCR and is not supported yet.", true);
    build(pageTexts);
    setStatus("Ready: " + f.name + " (" + pdf.numPages + " pages, " + chunks.length + " passages).");
  } catch (err) {
    setStatus("Could not read this PDF. It may be corrupt or password-protected. (" + err.message + ")", true);
  }
});

// ---- 2. Chunk pages, build TF-IDF index, make summary ----
function build(pageTexts) {
  chunks = [];
  pageTexts.forEach((t, i) => {
    const w = t.split(" ").filter(Boolean);
    for (let s = 0; s < w.length; s += 70) {
      const part = w.slice(s, s + 90).join(" ");
      if (part.length > 20) chunks.push({ page: i + 1, text: part, terms: tok(part) });
      if (s + 90 >= w.length) break;
    }
  });
  const df = {};
  chunks.forEach(c => {
    c.tf = {};
    c.terms.forEach(t => c.tf[t] = (c.tf[t] || 0) + 1);
    Object.keys(c.tf).forEach(t => df[t] = (df[t] || 0) + 1);
  });
  idf = {};
  Object.keys(df).forEach(t => idf[t] = Math.log(1 + chunks.length / (1 + df[t])));

  // Extractive summary: pick the 5 sentences with the most important words
  const all = pageTexts.join(" ");
  const freq = {};
  tok(all).forEach(t => freq[t] = (freq[t] || 0) + 1);
  const sents = (all.match(/[^.!?]+[.!?]/g) || []).map(s => s.trim()).filter(s => s.length > 40 && s.length < 300);
  const top = sents.map((s, i) => {
      const t = tok(s);
      const sc = t.reduce((a, w) => a + (freq[w] || 0) * (idf[w] || 0), 0) / Math.pow(t.length || 1, 0.7);
      return { s, i, sc };
    })
    .sort((a, b) => b.sc - a.sc).slice(0, 5)
    .sort((a, b) => a.i - b.i).map(x => x.s);
  $("summary").textContent = top.length ? top.join(" ") : all.slice(0, 500) + "...";
  $("sumCard").hidden = false;
}

// ---- 3. Retrieval: rank passages against the question ----
function search(q) {
  const qt = [...new Set(tok(q))].filter(t => idf[t]);
  if (!qt.length) return { hits: [], qt };
  const need = qt.length >= 3 ? 2 : 1;   // too few matching words = "not in document"
  const hits = chunks.map(c => {
      let m = 0, sc = 0;
      qt.forEach(t => { if (c.tf[t]) { m++; sc += (1 + Math.log(c.tf[t])) * idf[t]; } });
      return { c, m, sc: sc / Math.sqrt(1 + Math.log(1 + c.terms.length)) };
    })
    .filter(h => h.m >= need)
    .sort((a, b) => b.sc - a.sc).slice(0, 3);
  return { hits, qt };
}

function highlight(text, qt) {
  const set = new Set(qt);
  return text.split(/([A-Za-z0-9]+)/).map((p, i) =>
    i % 2 ? (set.has(tok(p)[0]) ? "<mark>" + p + "</mark>" : p) : esc(p)).join("");
}

// ---- 4. Optional: Gemini writes the answer from retrieved passages only ----
async function gemini(q, hits, key) {
  const ctx = hits.map(h => "[Page " + h.c.page + "] " + h.c.text).join("\n\n");
  const prompt = "Answer the question using ONLY the passages below. Cite page numbers like (p. 3). " +
    "If the passages do not contain the answer, reply exactly: Not found in the document.\n\nPASSAGES:\n" + ctx + "\n\nQUESTION: " + q;
  const model = $("model").value.trim() || "gemini-2.5-flash";
  const r = await fetch("https://generativelanguage.googleapis.com/v1beta/models/" + encodeURIComponent(model) + ":generateContent", {
    method: "POST",
    headers: { "Content-Type": "application/json", "x-goog-api-key": key },
    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }], generationConfig: { temperature: 0 } })
  });
  const d = await r.json();
  if (!r.ok) throw new Error(d.error && d.error.message ? d.error.message : "HTTP " + r.status);
  const parts = d.candidates && d.candidates[0] && d.candidates[0].content && d.candidates[0].content.parts;
  return parts ? parts.map(p => p.text).join("") : "(empty reply)";
}

// ---- 5. Chat ----
function addMsg(kind, text, hits, qt) {
  const log = $("log");
  const empty = log.querySelector(".empty");
  if (empty) empty.remove();
  const d = document.createElement("div");
  d.className = "msg " + (kind === "err" ? "err" : kind === "user" ? "user" : "");
  const p = document.createElement("p");
  p.textContent = text || "Best matching passages from the document:";
  d.appendChild(p);
  (hits || []).forEach(h => {
    const s = document.createElement("div");
    s.className = "src";
    s.innerHTML = "<b>Page " + h.c.page + "</b><br>" + highlight(h.c.text, qt);
    d.appendChild(s);
  });
  log.appendChild(d);
  d.scrollIntoView({ block: "nearest" });
}

async function ask() {
  const q = $("q").value.trim();
  if (!q) return;
  if (!chunks.length) return addMsg("err", "No document yet. Upload a PDF first, then ask your question.");
  $("q").value = "";
  addMsg("user", q);
  const { hits, qt } = search(q);
  if (!hits.length) return addMsg("bot", "This is not covered in the document, so there is no answer to give.");
  let ans = null;
  if ($("useAI").checked) {
    const key = $("key").value.trim();
    if (!key) addMsg("err", "Add a Gemini API key to use AI answers. Showing matching passages instead.");
    else {
      try { ans = await gemini(q, hits, key); }
      catch (e) { addMsg("err", "Gemini request failed: " + e.message + " Showing matching passages instead."); }
    }
  }
  addMsg("bot", ans, hits, qt);
}
$("askBtn").addEventListener("click", ask);
$("q").addEventListener("keydown", e => { if (e.key === "Enter") ask(); });
</script>
</body>
</html>
